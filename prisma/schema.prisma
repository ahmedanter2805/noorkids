// Prisma Schema for NoorKids Gamified Islamic Learning Platform
// Configured for Supabase PostgreSQL (Production & Local)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         String    @default("CHILD") // CHILD | PARENT | ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  childProfile  Child?
  parentProfile Parent?
  adminProfile  Admin?
}

model Parent {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  children    Child[]
  createdAt   DateTime @default(now())
}

model Child {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        Parent?      @relation(fields: [parentId], references: [id], onDelete: SetNull)
  age           Int          @default(7)
  avatar        String       @default("star-kid")
  xpPoints      Int          @default(0)
  level         Int          @default(1)
  currentStreak Int          @default(1)
  lastActiveDay String?      // YYYY-MM-DD for tracking streaks
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  progress      Progress[]
  quizResults   QuizResult[]
  badges        ChildBadge[]
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  title       String
  category    String   // QURAN | SALAH | RAMADAN | ISLAMIC_STORIES | MUSLIM_CHARACTER
  description String
  icon        String   // Lucide icon name or emoji
  colorTheme  String   // e.g. "sky", "emerald", "amber", "indigo", "rose"
  isPublished Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
}

model Lesson {
  id              String     @id @default(cuid())
  courseId        String
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  arabicHighlight String     // Surah verse with Tashkeel, Dua, or Hadith
  content         String     // JSON serialized array of interactive cards/steps
  challengePrompt String     // Practical challenge or deed prompt
  xpReward        Int        @default(20)
  orderIndex      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  quizzes         Quiz[]
  progress        Progress[]
}

model Quiz {
  id           String       @id @default(cuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int          @default(70) // Percentage required to pass
  bonusXP      Int          @default(30)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  questions    Question[]
  quizResults  QuizResult[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  options       String   // JSON stringified array of options
  correctAnswer String   // Exact string or index
  explanation   String   // Kid-friendly explanation with Arabic term when applicable
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
}

model Progress {
  id                   String   @id @default(cuid())
  childId              String
  child                Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted          Boolean  @default(false)
  completionPercentage Int      @default(0)
  lastAccessed         DateTime @default(now())

  @@unique([childId, lessonId])
}

model QuizResult {
  id             String   @id @default(cuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int      // e.g. 100, 66, etc.
  totalQuestions Int
  earnedXP       Int      @default(0)
  submittedAt    DateTime @default(now())
}

model Badge {
  id                String       @id @default(cuid())
  name              String
  description       String
  icon              String       // Icon name or emoji
  requiredXP        Int          @default(0)
  categoryCondition String?      // e.g. "QURAN", "SALAH", "RAMADAN", "STORIES", "CHARACTER", or null for general XP
  createdAt         DateTime     @default(now())

  children          ChildBadge[]
}

model ChildBadge {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([childId, badgeId])
}
